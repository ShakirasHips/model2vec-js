{
  "name": "mini-semantic-search",
  "version": "0.1.0",
  "description": "Semantic search with a MiniSearch-style API, using Model2Vec static embeddings. Runs in browsers and Node; no dependencies; 2.2 MB with the model.",
  "keywords": [
    "semantic-search",
    "search",
    "minisearch",
    "model2vec",
    "embeddings",
    "static-embeddings",
    "sentence-embeddings",
    "browser",
    "offline"
  ],
  "license": "MIT",
  "author": "ShakirasHips",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShakirasHips/model2vec-js.git"
  },
  "homepage": "https://github.com/ShakirasHips/model2vec-js#readme",
  "bugs": "https://github.com/ShakirasHips/model2vec-js/issues",
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./models/*": "./models/*"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "mini-semantic-search": "dist/cli.js"
  },
  "files": [
    "dist",
    "models",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "./dist/node.js",
    "./dist/cli.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0"
  }
}
